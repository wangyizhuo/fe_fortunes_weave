[["一、总结（数字都是「加点项数」；期望 = 同职业同等级、随机种子下的平均，含保底 2 项）"],["角色","当前Lv","记录起点","过去升级","过去跳过","其中没记录的步","过去实际加点","过去期望","偏差","被跳掉的几级：实际项数","被跳掉的：期望","已观星还没做（升/跳）","未来路线","未来加点","未来期望","偏差","其中种子本身（不考、主职业直升）","直升期望","结论"],["迪托利希",25,"Lv16",9,3,3,47,40.4,"+6.6",11,13.2,"0 / 0","Lv25→35（考1次）",57,45.9,"+11.1",52,46.3,"过去比期望多 6.6 项（9 级）。另有 3 步没记录（按种子算是 4、3、4 项，平均水平，不像是专门跳掉的烂级）。未来比期望多约 11 项：种子本身偏好（+5.7），考试和换职业再多 +5。更好。"],["法毕欧",22,"Lv10",12,2,0,45,44.8,"+0.2",6,7.5,"0 / 1","Lv22→32（考1次）",48,38.0,"+10.0",40,37.4,"过去和期望基本持平（+0.2），跳掉的 2 级确实偏差（6 项，期望 7.5）。未来比期望多约 10 项，主要来自考牧师和挑职业（种子本身 +2.6）。更好。"],["艾丝梅拉尔达",21,"Lv12",9,3,0,37,34.1,"+2.9",8,11.5,"2 / 0","没有种子","","","","","","过去比期望多 2.9 项，跳了 3 次（跳掉的 3 级只有 8 项，期望 11.5，跳得对）。已观星的 2 级很好（12 项）。没有种子，未来没法推。"],["米迦艾拉",22,"Lv11",11,3,2,49,41.3,"+7.7",11,11.2,"0 / 0","Lv22→32（考2次）",49,38.5,"+10.5",37,37.4,"过去比期望多 7.7 项，跳了 3 次（2 次没记录；跳掉的 3 级合计 11 项，和期望一样，不算烂级）。未来比期望多约 10.5 项，种子本身平均，多出来的全靠考试和挑职业。更好。"],["杨界",21,"Lv12",9,1,0,41,33.7,"+7.3",3,3.7,"2 / 1","Lv23→33（考0次）",38,37.4,"+0.6",38,37.4,"过去比期望多 7.3 项，只跳了 1 次。未来和期望基本一样（+0.6），不用考试。符合预期。"],["伊欧",23,"Lv21",2,0,0,9,7.3,"+1.7","","","1 / 0","没有种子","","","","","","记录太少（2 级），比期望多 1.7 项；已观星的战车兵那级 7 项。没有种子，未来没法推。"],["奇洛伊卡",17,"Lv11",6,0,0,24,21.6,"+2.4","","","4 / 2","没有种子","","","","","","过去比期望多 2.4 项，没跳过。已观星的 4 级略好（12 项，期望 10.9）。没有种子，未来没法推。"],["努蒂奴",17,"Lv14",3,0,0,14,11.2,"+2.8","","","4 / 0","Lv21→31（考2次）",40,37.6,"+2.4",37,37.4,"过去比期望多 2.8 项，没跳过；已观星的 4 级也多 3 项。未来比期望多 2.4 项，种子本身平均。略好。"],["乌尔坦德",18,"Lv14",4,1,0,18,16.8,"+1.2",2,4.2,"2 / 0","Lv20→30（考1次）",49,42.8,"+6.2",43,42.0,"过去比期望多 1.2 项，跳了 1 次（跳掉的那级只有 2 项）。未来比期望多约 6 项，主要靠考牧师（种子本身 +1）。更好。"],[""],["二、不确定的地方"],["角色","哪一步","不确定什么","现在怎么处理"],["全部","等级标签","备份 startLevel 和主表「成长记录」的等级都是「升完之后」的等级（11-05 截图对过 6 个人的加点）。之前的路线把除迪以外的人都多算了 1 级。","已统一改成「升完后的等级」，页面和「成长路线」等级列都已改。"],["全部","第一条记录之前","从加入到第一条观星记录之间的升级没有记录，种子也接不上，没法反推。","过去只统计有记录的部分。"],["迪托利希","Lv24→25","主表写了「25 great」但没记加点，备份里也没有这一条。按种子算出是 HP 力 速 防 魔防 幸 魅，和 11-01→11-05 截图的能力差对上。","当作已做的一次剑客升级，种子往后推一步。所以迪的未来路线整体往后挪了一步（考试从 2 次变 1 次）。"],["迪托利希","Lv17、19、20 之后","种子要多走 3 步才能接上后面的记录，多半是没记下来的考试，也可能是没记的升级预览。","按「没记录的一步（考试）」算，不计加点。"],["迪托利希","Lv18→19","主表只记了 HP 力，种子算出 HP 力 魔 技。","多半是少记了 2 项，按种子算的为准。"],["迪托利希","Lv21、23 两个职业","同一级记了斗士和剑客两种预览（换职业不推进种子）。","只算实际用的那个职业。"],["法毕欧","Lv11→12、Lv19→20","记录和种子各差 1 项（记录少了技 / 少了幸）。","多半是少记，按种子算的为准。"],["米迦艾拉","Lv15、16 之后","种子多走了 2 步，没有对应记录。","按「没记录的一步（考试）」算。"],["米迦艾拉","Lv17→18","记录有「防」，种子算出没有。","按种子算的为准（只差 1 项）。"],["杨界","第 1、2 条记录","种子从第 3 条起才接得上，前 2 条没法验证。","前 2 条照记录算。"],["杨界","Lv13→14（第 3 条）","记录 技 防 魔防 幸 魅，种子算出 技 魔防 魅。","按种子算的为准。"],["杨界","主表 23、24 两行","主表标的 23、24，但备注写「跳22，new 22 great」，按种子是 22、23。","按 22、23 算（现在 Lv21，这两级和中间的考试都还没做）。"],["乌尔坦德","Lv15→16","主表这一级没记加点。","用种子算出的 HP 力 魔 魅。"],["乌尔坦德","11-01→11-05 能力差","截图的能力差和 Lv15→18 的记录对不太上（差 2～3 项），可能 11-01 的截图读错一行。","不影响种子，只标出来。"],["伊欧","Lv22→23","备份把「速 技 防 魔防 幸」标成跳过，主表写的是升到 23。","按主表算：已升。战车兵那条（主表 24）是还没做的一级。"],["伊欧","种子","记录只有 3 条，全种子搜索有 4 个候选；拿主表「24 轻骑兵 bad 速 技 魔防」去筛，4 个都对不上（可能中间还有没记的一步），定不下来。","没有种子，未来不做推算。"],["艾丝梅拉尔达","种子","职业多次在飞鸵兵 / 斗士 / 天翼兵之间换，还有坐骑加成，全种子搜索没有找到完全对上的种子。","没有种子，过去照记录算，未来不做推算。"],["奇洛伊卡","种子 / 后 3 条","备份后 3 条没有加点；主表多了「21 bad HP 技」，还有几级同时记了猎兵/斗士两种预览。全种子搜索没有找到完全对上的种子。","照记录算。"],["全部","期望值","期望按「个人+职业」成长率算，没算坐骑（伊欧的罗西南、艾丝的飞马）和技能加成。","这两人的期望略偏低。"],[""],["三、逐步列表（每一条 = 种子前进一步）"],["角色","记录#","等级","动作","职业","观星记录的加点","种子算出的加点","对上？","项数","期望项数","加权分","期望加权分","状态","备注"],["迪托利希","1","16→17","升级","斗士","力 技 幸 魅","力 技 幸 魅","✓",4,4.4,12,13.1,"已完成"],["迪托利希","2-","(Lv17)","没记录的一步","斗士","","HP 技 防 魔防","",4,4.4,13,13.1,"已完成"],["迪托利希","2","17→18","升级","斗士","力 速 技 防 幸 魅","力 速 技 防 幸 魅","✓",6,4.4,20,13.1,"已完成"],["迪托利希","3","18→19","升级","斗士","HP 力","HP 力 魔 技","✗",4,4.4,12,13.1,"已完成"],["迪托利希","4-","(Lv19)","没记录的一步","斗士","","HP 魔 速","",3,4.4,8,13.1,"已完成"],["迪托利希","4","19→20","升级","斗士","速 防 魔防 魅","速 防 魔防 魅","✓",4,4.4,12,13.1,"已完成"],["迪托利希","5-","(Lv20)","没记录的一步","斗士","","HP 速 魔防 魅","",4,4.4,11,13.1,"已完成"],["迪托利希","5","20→21","升级","斗士","力 魔 技 防 幸","力 魔 技 防 幸","✓",5,4.4,15,13.1,"已完成"],["迪托利希","6","21